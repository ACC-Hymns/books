    },
    "239": {
        "title": "Забери мене, Ісусе, із земної суєти"
    },
    "240": {
        "title": "Тихий Агнцю – миру Князь"
    },
    "241": {
        "title": "Чом скаржишся, душе"
    },
    "242": {
        "title": "В моє тривожне серце"
    },
    "243": {
        "title": "Є любов'ю те"
    },
    "244": {
        "title": "На землі чекання – це є школа"
    },
    "245": {
        "title": "Із розпаленої печі"
    },
    "246": {
        "title": "Простота свята і милість"
    },
    "247": {
        "title": "Прагну в моїм Ісусі вмерти"
    },
    "248": {
        "title": "Тіло закопуємо це"
    },
    "249": {
        "title": "Хто це пред престолом Божим"
    },
    "250": {
        "title": "Велич! Падаєм пред Тебе"
    },
    "251": {
        "title": "Єгова! Повіки честь і слава"
    },
    "252": {
        "title": "Оздоба й слава християн"
    },
    "253": {
        "title": "Час мого життя біжить"
    },
    "254": {
        "title": "Добре є прославляти Господа"
    },
    "255": {
        "title": "Як Господь повертав полонених Сіону"
    },
    "256": {
        "title": "Той, хто під покровом Всевишнього"
    },
    "257": {
        "title": "Господній нині день!"
    },
    "258": {
        "title": "В полях були пастухи"
    },
    "259": {
        "title": "Я знаю милий, гарний край"
    },
    "260": {
        "title": "Вірним аж до смерті будь"
    },
    "261": {
        "title": "У житті найбільша радість"
    },
    "262": {
        "title": "Бога хваліть, Бога хваліть, всі народи"
    },
    "263": {
        "title": "Де може знайти відпочинок душа"
    },
    "264": {
        "title": "Бог з вами, браття дорогі"
    },
    "265": {
        "title": "Зволь іти"
    },
    "266": {
        "title": "Пригорни мене до Себе"
    },
    "267": {
        "title": "Як хтось у світ вертається"
    },
    "268": {
        "title": "Алилуя! Гарний ранок"
    },
    "269": {
        "title": "Славте Бога у святині"
    },
    "270": {
        "title": "Духу мій, спинися трохи"
    },
    "271": {
        "title": "Ми Біблію не лишим"
    },
    "272": {
        "title": "О, вже коли прийде час, щоб я йшов"
    },
    "273": {
        "title": "Радісно, радісно йду я вперед"
    },
    "274": {
        "title": "Я більше не земна дитина"
    },
    "275": {
        "title": "Весь у роздумах небесних"
    },
    "276": {
        "title": "Душе, утішайся"
    },
    "277": {
        "title": "Чуй співи ангелів"
    },
    "278": {
        "title": "Я за тим життям силкуюсь"
    },
    "279": {
        "title": "Господу всі подяку несім"
    },
    "280": {
        "title": "Ще є один спочинок – славний"
    },
    "281": {
        "title": "Смерть христьянина"
    },
    "282": {
        "title": "Хто це пред престолом Божим"
    },
    "283": {
        "title": "За тим рідним, тихим краєм"
    },
    "284": {
        "title": "Ось, гряде Господь, Цар слави"
    },
    "285": {
        "title": "Навіщо нині серце засмучуєте"
    },
    "286": {
        "title": "Без турботи йди у спокій"
    },
    "287": {
        "title": "Не залишай! О Боже мій, благаю"
    },
    "288": {
        "title": "Вірний Приятель, Ісус"
    },
    "289": {
        "title": "Гріб вже порожній, гріб пустий"
    },
    "290": {
        "title": "Як радісно мені"
    },
    "291": {
        "title": "О Ісус, Спаситель мій"
    },
    "292": {
        "title": "Серце питає: О Ісус, скажи"
    },
    "293": {
        "title": "Чи побачимося знову"
    },
    "294": {
        "title": "Так! Колись воскреснеш, порох мій"
    },
    "295": {
        "title": "Милий спокій після тягот денних "
    },
    "296": {
        "title": "Лиш в край той милий знов і знов"
    },
    "297": {
        "title": "Що може бути кращим"
    },
    "298": {
        "title": "Колись Ти знову прийдеш"
    },
    "299": {
        "title": "Знаєте ви, Хто славний Божий Син?"
    },
    "300": {
        "title": "Знаєте край, що не на цій землі?"
    },
    "301": {
        "title": "В той прекрасний Дім небесний"
    },
    "302": {
        "title": "О, радість! Мій Спаситель живе"
    },
    "303": {
        "title": "Ти світло наше, о Ісус"
    },
    "304": {
        "title": "Хто переможе"
    },
    "305": {
        "title": "Ніч вже минула, отож, пробудіться"
    },
    "306": {
        "title": "Якби я вже в тій славі"
    },
    "307": {
        "title": "Любі, прощаємось: з Господом йдіть!"
    },
    "308": {
        "title": "Бог – мій Псалом!"
    },
    "309": {
        "title": "Поглянь! У Гетсиманії"
    },
    "310": {
        "title": "Душе, на Ісуса вірно чекай"
    },
    "311": {
        "title": "Опісля днів випробування"
    },
    "312": {
        "title": "Ісус, моє життя Ти"
    },
    "313": {
        "title": "Спаситель є Керманич мій"
    },
    "314a": {
        "title": "Боже, до Тебе йду"
    },
    "314b": {
        "title": "Боже, до Тебе йду"
    },
    "315": {
        "title": "Хай звучить твій спів і арфа"
    },
    "316": {
        "title": "О, який солодкий, милий"
    },
    "317": {
        "title": "Чом боїшся?! Глянь на мужа"
    },
    "318": {
        "title": "Я Ісуса не лишу"
    },
    "319": {
        "title": "До Ісусового гробу"
    },
    "320": {
        "title": "Ти любиш нас"
    },
    "321": {
        "title": "На лоні у Ісуса"
    },
    "322": {
        "title": "Я Тебе, Спаситель милий"
    },
    "323": {
        "title": "Славний Сіоне, небесний"
    },
    "324": {
        "title": "Боже, все життя моє"
    },
    "325": {
        "title": "Коли спокій Божий панує в душі"
    },
    "326": {
        "title": "Повіки з Господом"
    },
    "327": {
        "title": "О, як приємно, як між братами"
    },
    "328": {
        "title": "Славу Тобі даю, Єгово"
    },
    "329": {
        "title": "Якби міг тисячу мов знати"
    },
    "330": {
        "title": "Вас у Господі вітаєм"
    },
    "331": {
        "title": "У край той небесний я прагну завжди"
    },
    "332": {
        "title": "Так є добре, як Бог чинить"
    },
    "333": {
        "title": "Хто дні людям призначає"
    },
    "334": {
        "title": "Тиша й спокій опустились"
    },
    "335": {
        "title": "Хай підняті будуть ворота звитяги"
    },
    "336": {
        "title": "О Пастир мій"
    },
    "337": {
        "title": "Здіймайся вверх"
    },
    "338": {
        "title": "Ось, Христос зове сьогодні"
    },
    "339": {
        "title": "Вже недалеко день"
    },
    "340": {
        "title": "Хто з слізьми засіває сім'я"
    },
    "341": {
        "title": "Все терпи!"
    },
    "342": {
        "title": "Після денних мук і втоми"
    },
    "343": {
        "title": "Дух Святий, зі мною будь"
    },
    "344": {
        "title": "Пробудись!"
    },
    "345": {
        "title": "Як я живу в Христі"
    },
    "346": {
        "title": "Довір свої дороги"
    },
    "347": {
        "title": "Там, над зірками, колись засвітає"
    },
    "348": {
        "title": "Блажен той"
    },
    "349": {
        "title": "Втішайтеся, народи всі"
    },
    "350": {
        "title": "Душі моїй знана прекрасна ріка"
    },
    "351": {
        "title": "Господь мій споглядає"
    },
    "352": {
        "title": "Єрусалим, збудований вгорі"
    },
    "353": {
        "title": "Всі Єгову славмо нині"
    },
    "354": {
        "title": "По цій землі проходить"
    },
    "355": {
        "title": "Здіймайся вверх, моєї арфи пісня"
    },
    "356": {
        "title": "Все серце хочеш Ти"
    },
    "357": {
        "title": "До хреста, о подорожній"
    },
    "358": {
        "title": "Слав, душе, Господа"
    },
    "359": {
        "title": "Свят, свят, свят Бог вічний"
    },
    "360": {
        "title": "Як у дні тяжкі, скорботні"
    },
    "361": {
        "title": "Заслуга ця Твоя, Ісус"
    },
    "362": {
        "title": "Візьми мене за руки, о Господи"
    },
    "363": {
        "title": "О Голово Христова"
    },
    "364": {
        "title": "О, прийдіть, співайте"
    },
    "365": {
        "title": "О Єрусалиме славний"
    },
    "366": {
        "title": "Боже, моє спасіння й щит"
    },
    "367": {
        "title": "Славте всі Господа!"
    },
    "368": {
        "title": "О, зберись, мала черідко"
    },
    "369": {
        "title": "Брати мої, не стіймо"
    },
    "370": {
        "title": "Там пальми перемоги"
    },
    "371": {
        "title": "Завжди на думці рідний Край"
    },
    "372": {
        "title": "Хоч і часом так здається"
    },
    "373": {
        "title": "Рідний Край нам сіяє з небес"
    },
    "374": {
        "title": "Послухайте слова святі"
    },
    "375": {
        "title": "Бог – Пастир мій"
    },
    "376": {
        "title": "О! Візьміть сіонські арфи"
    },
    "377": {
        "title": "Однодумно, в братській згоді"
    },
    "378": {
        "title": "Господь хай з вами буде"
    }
}